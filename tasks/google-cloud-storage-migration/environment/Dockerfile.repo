# syntax=docker/dockerfile:1
FROM eclipse-temurin:8-jdk

RUN apt-get update && apt-get install -y --no-install-recommends curl git python3 unzip \
 && rm -rf /var/lib/apt/lists/* \
 && curl -L --fail --retry 3 -o /tmp/grails.zip \
      https://github.com/apache/grails-core/releases/download/v2.3.11/grails-2.3.11.zip \
 && unzip -q /tmp/grails.zip -d /opt \
 && rm -f /tmp/grails.zip

ENV GRAILS_HOME=/opt/grails-2.3.11
ENV JAVA_HOME=/opt/java/openjdk
WORKDIR /app
COPY . /app/
RUN rm -rf .git test web-app/testData grails-app/conf/google-service-account.json \
 && find . -type f \( -name '.env' -o -name '.env.*' -o -name '*.pem' -o -name '*.key' \) -delete \
 && git init -qb main \
 && git config user.email evaluator@example.invalid \
 && git config user.name evaluator \
 && git add -A && git commit -qm 'import sanitized task base' \
 && mkdir -p /logs/verifier
CMD ["/bin/bash"]
