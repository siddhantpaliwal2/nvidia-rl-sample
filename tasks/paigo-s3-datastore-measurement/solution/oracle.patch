+    static async publishFailureToDLQ(
+        failedDocument,
+        metadata: MeasurementFailureMetadata,
+        dlqType: DlqType,
+        businessID
+    ) {
+        if (dlqType === DlqType.s3) {
+            // Write to the DLQ S3 bucket which is in env variables:DB_MEASUREMENT_DLQ_BUCKET_NAME
+            // The folder name is the businessID
+            // File name is orginalProcessedName
+            // File content is the failedDocument and the metadata
+
+            const s3 = new S3Client({ region: process.env.AWS_REGION });
+            const originalKey = metadata.orginalProcessedName.replace(new RegExp(`^${businessID}/?`), '');
+            const params = {
+                Bucket: process.env.DB_MEASUREMENT_DLQ_BUCKET_NAME,
+                Key: `${businessID}/${originalKey}.message.text`,
+                Body: JSON.stringify({ failedDocument, metadata }),
+            };
+            try {
+                await s3.send(new PutObjectCommand(params));
+            } catch (e) {
+                AuditService.publishEvent({
+                    topic: AuditScope.ERROR,
+                    message: 'Failed to write to DLQ',
+                    data: [{ error: e, failedDocument, metadata, dlqType }],
+                });
+            }
+        }
+    }
+}
+
+export class MeasurementFailureMetadata {
+    message: string;
+    id: string;
+    timestamp: string;
+    results: string;
+    /**
+     * This is the processed name from the system where the measurement occured
+     * In S3 its the complete fileName
+     * */
+    orginalProcessedName: string;
+
+    constructor({ message, id, timestamp, results }: MeasurementFailureMetadata) {
+        this.message = message;
+        this.id = id;
+        this.timestamp = timestamp;
+        this.results = results;
+    }
 }
