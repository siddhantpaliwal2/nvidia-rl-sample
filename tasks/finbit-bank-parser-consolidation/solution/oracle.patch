+    public static void extractTransactionsUsingRegex(ProcessedBankStatementVO processedBankStatementVO) {
+        File textFile = processedBankStatementVO.processBankStatementCO.textFile
+        SimpleDateFormat dateFormat = new SimpleDateFormat("dd-MMM-yyyy")
+        List<StringBuilder> transactions = []
+        Double prevBalance = 0
+        String line = ""
+        textFile.withReader("UTF-8") { bufferedReader ->
+            while ((line = bufferedReader.readLine()) != null) {
+                if (StringUtils.isBlank(line)) continue
+                else if (line.find("\\(INR\\)[\\s]*\\(INR\\)[\\s]*\$")) {
+                    while ((line = bufferedReader.readLine()) != null && !line.find("^[\\s]*(Page[\\s]*Total[\\s]*:)|(Unless[\\s]*the[\\s]*constituent)")) {
+                        if (StringUtils.isBlank(line) || line.find("^[\\s]*(-+[\\s]*\$)|(Page[\\s]+\\d[\\s]*\$)|(REP_\\d[\\s]*\$)|(NEXT[\\s]*PAGE)")) continue
+                        if (line.find("^[\\s]*${AppConstant.dateRegex}")) {
+                            transactions << new StringBuilder(line)
+                        } else {
+                            transactions.last().append(line)
+                        }
+                    }
+                }
+            }
+        }
+        line = transactions.first().toString()
+        if (line.find("B/F")) {
+            transactions.remove(0)
+            prevBalance = BankUtil.processBalanceAmount(line.find("${AppConstant.currencyRegex}[\\s]*[CcDd][Rr]"))
+            processedBankStatementVO.bankTransactionList << BankUtil.createOpeningBalanceTransaction(prevBalance)
+            processedBankStatementVO.bankTransactionList.first().transactionDate = dateFormat.parse(line.find("^[\\s]*${AppConstant.dateRegex}").trim())
+        }
+        transactions.eachWithIndex { StringBuilder transaction, int index ->
+            String date = null
+            String remark = null
+            Double balance = null
+            String description = null
+            List<String> amounts = []
+            try {
+                date = transaction.find("^[\\s]*${AppConstant.dateRegex}")?.replaceAll("[\\s]+", "")
+                amounts = transaction.findAll("[\\s]${AppConstant.currencyRegex}([\\s]*[CcDd][Rr])?")*.replaceAll("[\\s]+", "")
+                remark = transaction.find("[\\s]\\d{5,6}[\\s]+${AppConstant.currencyRegex}[\\s]")
+                remark = remark ? remark.find("^[\\s]\\d{5,6}[\\s]").replaceAll("[\\s]+", "") : null
+                description = transaction.replaceAll(date, "").replaceAll("[\\s]${AppConstant.currencyRegex}([\\s]*[CcDd][Rr])?", "")
+                description = remark ? description.replaceAll(remark, "") : description.trim()
+                balance = BankUtil.processBalanceAmount(amounts.last().toString())
+                BankTransactionResponse transactionResponse = new BankTransactionResponse()
+                transactionResponse.transactionDate = dateFormat.parse(date)
+                transactionResponse.description = description.replaceAll("[\\s]+", " ")
+                transactionResponse.amount = HelperMethod.getSanitizeDouble(amounts.first().toString())
+                transactionResponse.balanceAfterTransaction = balance
+                transactionResponse.remark = remark
+                transactionResponse.type = prevBalance < transactionResponse.balanceAfterTransaction ?
+                        Enums.BankTransactionType.CREDIT : Enums.BankTransactionType.DEBIT
+                processedBankStatementVO.bankTransactionList << transactionResponse
+                prevBalance = balance
+            } catch (Exception e) {
+                processedBankStatementVO.statementStatus.statementParsedStatus = Enums.StatementParsedStatus.TRANSACTION_PARTIALLY_PARSED
+                processedBankStatementVO.statementStatus.message = "Exception occurred during parsing Andhra Bank Current Account statement using regex ====>>>>>> ${e.message}"
+                processedBankStatementVO.statementStatus.exceptionStackTrace = AppUtil.getStackTraceAsString(e)
+                log.error(processedBankStatementVO.statementStatus.message, e)
+            }
+        }
+        BankUtil.checkForOpeningBalanceTransaction(processedBankStatementVO.bankTransactionList,
+                processedBankStatementVO.basicDetails.fromDate?.getTime())
+        BankUtil.findFromAndToDate(processedBankStatementVO.bankTransactionList.first(),
+                processedBankStatementVO.bankTransactionList.last(), processedBankStatementVO.basicDetails)
+    }
