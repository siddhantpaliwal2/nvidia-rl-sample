+import { MongoDataStoreEntity } from '../../datastore/entites/mongoDataStoreEntity.entity';
+import { DatastoreService } from '../../datastore/datastore.service';
+import process from 'node:process';
+import { HttpStatus } from '@nestjs/common';
+import { BackoffOptions } from 'exponential-backoff';
+import { sleep } from '../../utils/sleep';
+import { PinoLogger } from 'nestjs-pino';
+import { loggerOptions, stream } from '../../logger';
+
+const RESERVED_RATE_LIMIT = Number(process.env.RESERVED_RATE_LIMIT) || 100;
+
+export const logger = new PinoLogger({
+  pinoHttp: [loggerOptions, stream],
+});
+
+export class RecoverableError extends Error {}
+
+export const backoffRetryOption: BackoffOptions = {
+  retry: (err) => err instanceof RecoverableError,
+  maxDelay: 10 * 1000,
+  startingDelay: 1000,
+};
+
+export const initMongoDb = async () => {
+  const dataSourceLogger: any = new PinoLogger({
+    pinoHttp: [loggerOptions, stream],
+  });
+  dataSourceLogger.setContext(MongoDataStoreEntity.name);
+  dataSourceLogger.log = dataSourceLogger.info;
+  const mongoDataStoreEntity = new MongoDataStoreEntity();
+  mongoDataStoreEntity.logger = dataSourceLogger;
+  await mongoDataStoreEntity.init();
+  DatastoreService.mongoDataStoreEntity = mongoDataStoreEntity;
+  return mongoDataStoreEntity;
+};
+
+const pauseOnLowRateLimit = async (headers: Headers) => {
+  const remainingRateLimit = Number(headers.get('x-ratelimit-remaining'));
+  if (remainingRateLimit <= RESERVED_RATE_LIMIT) {
+    // Sleep until next rate limit window
+    const diff = Number(headers.get('x-ratelimit-reset')) * 1000 - Date.now();
+    if (diff > 0) {
+      logger.warn(
+        `Remaining rate limit(=${remainingRateLimit}) is low now, sleep ${diff}ms until next rate limit window.`,
+      );
+      await sleep(diff);
+    }
+  }
+};
+
+export const retrieveSmartLeadInboxDetail = async (id: string) => {
+  try {
+    const emailAccountResponse = await fetch(
+      `https://server.smartlead.ai/api/v1/email-accounts/${id}?api_key=${process.env.SMARTLEAD_REPORT_API_KEY}`,
+    );
+
+    if (emailAccountResponse.status === HttpStatus.TOO_MANY_REQUESTS) {
+      logger.warn('Failed to retrieve email account due to rate limiting');
+      throw new RecoverableError('Too many request');
+    }
+
+    const { headers, status } = emailAccountResponse;
+    if (status !== HttpStatus.OK) {
+      logger.error(
+        `Failed to retrieve email account, status=${emailAccountResponse.status}`,
+      );
+      throw new Error('Failed to retrieve inbox detail from smartlead');
+    }
+
+    await pauseOnLowRateLimit(headers);
+
+    return emailAccountResponse.json();
+  } catch (error) {
+    logger.error('Failed to retrieve email account, error: ', error);
+    throw error;
+  }
+};
+
+export const retrieveAllSmartLeadInboxes = async (): Promise<Array<any>> => {
+  const response = await fetch(
+    `https://server.smartlead.ai/api/email-account/get-total-email-accounts`,
+    {
+      headers: {
+        Authorization: `Bearer ${process.env.SMARTLEAD_SYNC_ACCESS_TOKEN}`,
+      },
+    },
+  );
+
+  if (response.status === HttpStatus.TOO_MANY_REQUESTS) {
+    logger.warn('Failed to retrieve all email accounts due to rate limiting');
+    throw new RecoverableError('Too many request');
+  }
+
+  if (response.status !== HttpStatus.OK) {
+    logger.error(
+      `Failed to retrieve inboxes from smartlead, status=${response.status}`,
+    );
+    throw new Error('Failed to retrieve inboxes from smartlead');
+  }
+
+  const {
+    data: { email_accounts },
+  } = await response.json();
+
+  return email_accounts;
+};
