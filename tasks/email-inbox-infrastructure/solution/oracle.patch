+import * as process from 'node:process';
+import { MongoDataStoreEntity } from '../../datastore/entites/mongoDataStoreEntity.entity';
+import { documentType } from '../../datastore/entites/documentType';
+import { EmailAccount, EmailTag } from '../entities/emailAccount.entity';
+import * as R from 'ramda';
+import { DatastoreService } from '../../datastore/datastore.service';
+import {
+  backoffRetryOption,
+  initMongoDb,
+  logger,
+  retrieveAllSmartLeadInboxes,
+  retrieveSmartLeadInboxDetail,
+} from './common';
+import { backOff } from 'exponential-backoff';
+
+const batchSize = Number(process.env.BATCH_SYNC_BATCH_SIZE) || 5;
+
+const loadBatchFromDB = async (
+  dataStore: MongoDataStoreEntity,
+  page: number,
+  pageSize: number,
+) => {
+  logger.info(
+    `Load data from collection ${documentType.EMAIL_ACCOUNT}, page=${page}, pageSize=${pageSize}`,
+  );
+  return dataStore.getManyAndAggregate(
+    {},
+    { documentType: documentType.EMAIL_ACCOUNT },
+    [
+      {
+        $sort: {
+          id: 1,
+        },
+      },
+    ],
+    { page, pageSize },
+  );
+};
+
+const updateEmailAccount = async (
+  record: Partial<EmailAccount>,
+  tagsMap: Map<string, EmailTag>,
+): Promise<void> => {
+  try {
+    const smartleadEmailAccount = await backOff(
+      () => retrieveSmartLeadInboxDetail(record.id),
+      backoffRetryOption,
+    );
+
+    const emailAccount = new EmailAccount({
+      ...record,
+      deliverabilityScore:
+        smartleadEmailAccount.warmup_details?.warmup_reputation,
+      tags: R.uniqBy(
+        R.prop('id'),
+        record.tags.concat(tagsMap.get(record.id) || []),
+      ),
+    });
+    await emailAccount.save(new DatastoreService());
+  } catch (err) {
+    logger.error(
+      `Failed to sync reputation and tags from smartlead, id=${record.id}`,
+    );
+  }
+};
+
+const buildInboxTagMap = async (): Promise<Map<string, EmailTag>> => {
+  const smartLeadEmailAccounts = await backOff(
+    () => retrieveAllSmartLeadInboxes(),
+    backoffRetryOption,
+  );
+  return smartLeadEmailAccounts.reduce(
+    (map, { id, email_account_tag_mappings }) => {
+      const tags = email_account_tag_mappings.map((item) => ({
+        id: `${item.tag.id}`,
+        name: item.tag.name,
+      }));
+      map.set(`${id}`, tags);
+      return map;
+    },
+    new Map<string, EmailTag>(),
+  );
+};
+
+const syncSmartleadInboxReputationAndTag = async () => {
+  const tagsMap = await buildInboxTagMap();
+  const mongoDataStoreEntity = await initMongoDb();
+  let currentPage = 0;
+  let records = await loadBatchFromDB(
+    mongoDataStoreEntity,
+    currentPage,
+    batchSize,
+  );
+
+  while (records.length > 0) {
+    records = await loadBatchFromDB(
+      mongoDataStoreEntity,
+      ++currentPage,
+      batchSize,
+    );
+
+    for (const record of records) {
+      await updateEmailAccount(record, tagsMap);
+    }
+  }
+};
+
+logger.setContext('sync-smartlead-inbox-reputation-and-tag');
+
+syncSmartleadInboxReputationAndTag()
+  .then(() => {
+    logger.info('Successfully synced Smartlead inbox reputation');
+    process.exit(0);
+  })
+  .catch((error) => {
+    logger.info(
+      'Failed to sync smartlead inbox reputation due to error: ',
+      error,
+    );
+    process.exit(1);
+  });
