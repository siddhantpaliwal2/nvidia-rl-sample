index 0000000000000000000000000000000000000000..96a75e0a4928cba6bc659c3be12d2d4f0b8c43a2
--- /dev/null
+++ b/src/emailinfra/entities/emailAccount.entity.ts
@@ -0,0 +1,308 @@
+import { Injectable, Logger, NotFoundException } from '@nestjs/common';
+import { DatastoreService } from '../../datastore/datastore.service';
+import { StoreDataDto } from '../../datastore/dto/store.dto';
+import { documentType } from '../../datastore/entites/documentType';
+import * as R from 'ramda';
+
+export enum Deliverability {
+  Unknown = 'Unknown',
+  High = 'High',
+  Medium = 'Medium',
+  Low = 'Low',
+  Burned = 'Burned',
+}
+
+export class EmailTag {
+  id: string;
+  name: string;
+}
+
+export class EmailAccount {
+  id: string;
+  smartleadClientId: string;
+  smartleadInboxId: string;
+  email: string;
+  domain: string;
+  deliverabilityScore: number;
+  deliverability: Deliverability;
+  campaignIds: string[] = [];
+  numberOfCampaignAssociated: number;
+  tags: EmailTag[] = [];
+  createdAt: string;
+
+  constructor(partial: Partial<EmailAccount>) {
+    Object.assign(this, R.omit(['_collection'], partial));
+
+    this.id = this.smartleadInboxId;
+    this.numberOfCampaignAssociated = partial.campaignIds?.length ?? 0;
+    this.domain = this.email.split('@')[1];
+    this.initDeliverability(partial.deliverabilityScore);
+  }
+
+  private initDeliverability(deliverabilityScore?: number) {
+    if (!deliverabilityScore) {
+      this.deliverability = Deliverability.Unknown;
+      return;
+    }
+
+    if (deliverabilityScore === 100) {
+      this.deliverability = Deliverability.High;
+    } else if (deliverabilityScore >= 98) {
+      this.deliverability = Deliverability.Medium;
+    } else if (deliverabilityScore >= 95) {
+      this.deliverability = Deliverability.Low;
+    } else {
+      this.deliverability = Deliverability.Burned;
+    }
+  }
+
+  public associateWithCampaign(campaignId: string) {
+    this.campaignIds = [...this.campaignIds, campaignId];
+    this.numberOfCampaignAssociated = this.campaignIds.length;
+  }
+
+  async save(datastoreService: DatastoreService): Promise<EmailAccount> {
+    await datastoreService.store(
+      new StoreDataDto({
+        data: {
+          id: this.id,
+          smartleadInboxId: this.smartleadInboxId,
+          smartleadClientId: this.smartleadClientId,
+          email: this.email,
+          domain: this.domain,
+          deliverability: this.deliverability,
+          deliverabilityScore: this.deliverabilityScore,
+          campaignIds: this.campaignIds,
+          numberOfCampaignAssociated: this.numberOfCampaignAssociated,
+          tags: this.tags,
+          createdAt: this.createdAt,
+        },
+        context: {
+          uniqueId: this.smartleadInboxId,
+          documentType: documentType.EMAIL_ACCOUNT,
+        },
+      }),
+    );
+    return this;
+  }
+
+  static async getAllBySmartleadClientId(
+    datastoreService: DatastoreService,
+    smartleadClientId: EmailAccount['smartleadClientId'],
+  ): Promise<EmailAccount[]> {
+    const res = await datastoreService.getByField({
+      fieldValue: smartleadClientId,
+      fieldKey: 'data.smartleadClientId',
+      documentType: documentType.EMAIL_ACCOUNT,
+    });
+
+    return (res.data ?? []).map((data: any) => new EmailAccount(data));
+  }
+
+  static async getByEmail(
+    datastoreService: DatastoreService,
+    email: EmailAccount['email'],
+  ): Promise<EmailAccount | undefined> {
+    const { data } = await datastoreService.getByField({
+      fieldValue: email,
+      fieldKey: 'data.email',
+      documentType: documentType.EMAIL_ACCOUNT,
+    });
+
+    if (!data?.length) {
+      throw new NotFoundException('Could not find email account by email');
+    }
+    return new EmailAccount(data[0]);
+  }
+
+  static async getManyByIds(
+    datastoreService: DatastoreService,
+    ids: EmailAccount['id'][],
+  ): Promise<EmailAccount[]> {
+    const { data } = await datastoreService.getByField({
+      fieldValue: { $in: ids },
+      fieldKey: 'id',
+      documentType: documentType.EMAIL_ACCOUNT,
+    });
+    return data.map((data: any) => new EmailAccount(data));
+  }
+
+  static async getById(
+    datastoreService: DatastoreService,
+    id: EmailAccount['id'],
+  ): Promise<EmailAccount> {
+    const { data } = await datastoreService.getById({
+      id,
+      documentType: documentType.EMAIL_ACCOUNT,
+    });
+
+    if (!data) {
+      throw new NotFoundException('Could not found email account by id');
+    }
+
+    return new EmailAccount(data);
+  }
+
+  static async getAll(
+    datastoreService: DatastoreService,
+    pagination?: { page: number; pageSize: number },
+  ): Promise<EmailAccount[]> {
+    const records = await datastoreService.getManyAndAggregate(
+      {},
+      { documentType: documentType.EMAIL_ACCOUNT },
+      [],
+      pagination,
+    );
+
+    return records.map((record: any) => new EmailAccount(record));
+  }
+
+  static async getBestXEmailAccounts(
+    datastoreService: DatastoreService,
+    smartleadClientId: EmailAccount['smartleadClientId'],
+    numberOfEmailAccount: number,
+  ): Promise<EmailAccount[]> {
+    const records = await datastoreService.getManyAndAggregate(
+      { 'data.smartleadClientId': smartleadClientId },
+      { documentType: documentType.EMAIL_ACCOUNT },
+      [
+        {
+          $lookup: {
+            from: documentType.EMAIL_ACCOUNT, // Join with the same collection
+            let: { current_domain: '$data.domain', current_id: '$_id' },
+            pipeline: [
+              // Match based on the extracted domain and exclude self
+              {
+                $match: {
+                  $expr: {
+                    $and: [
+                      { $eq: ['$data.domain', '$$current_domain'] }, // Compare derived domains
+                      { $ne: ['$_id', '$$current_id'] }, // Exclude self
+                    ],
+                  },
+                },
+              },
+              {
+                $count: 'count',
+              },
+            ],
+            as: 'otherEmailsData',
+          },
+        },
+        {
+          $addFields: {
+            otherEmailsUnderSameDomainCount: {
+              $ifNull: [{ $arrayElemAt: ['$otherEmailsData.count', 0] }, 0], // Extract count or default to 0
+            },
+          },
+        },
+        {
+          $sort: {
+            'data.deliverabilityScore': -1, // Deliverability (high → low)
+            'data.numberOfCampaignAssociated': 1, // Number of campaigns associated (few → more)
+            otherEmailsUnderSameDomainCount: 1, // Number of other mailboxes under same domain (few → more)
+            'data.createdAt': 1, // Age of mailboxes (old → new)
+          },
+        },
+      ],
+      { page: 0, pageSize: numberOfEmailAccount },
+    );
+
+    return records.map((record: any) => new EmailAccount(record));
+  }
+
+  static async delete(datastoreService: DatastoreService, id: string) {
+    await datastoreService.remove({
+      id,
+      documentType: documentType.EMAIL_ACCOUNT,
+    });
+  }
+}
+
+@Injectable()
+export class EmailAccountEntity {
+  private readonly logger = new Logger(EmailAccountEntity.name);
+  constructor(readonly datastoreService: DatastoreService) {}
+
+  public createEmailAccount(emailAccount: Partial<EmailAccount>) {
+    this.logger.log(`Creating email account ${emailAccount}`);
+    return new EmailAccount(emailAccount).save(this.datastoreService);
+  }
+
+  public getAllBySmartleadClientId(
+    smartleadClientId: string,
+  ): Promise<EmailAccount[]> {
+    this.logger.log(
+      `Getting email accounts by smartleadClientId: ${smartleadClientId}`,
+    );
+    return EmailAccount.getAllBySmartleadClientId(
+      this.datastoreService,
+      smartleadClientId,
+    );
+  }
+
+  public getByEmail(email: string): Promise<EmailAccount | undefined> {
+    this.logger.log(`Getting email account by email: ${email}`);
+    return EmailAccount.getByEmail(this.datastoreService, email);
+  }
+
+  public async getById(id: string): Promise<EmailAccount> {
+    this.logger.log(`Getting email account by id: ${id}`);
+    return EmailAccount.getById(this.datastoreService, id);
+  }
+
+  public async getAll(pagination?: { page: number; pageSize: number }) {
+    this.logger.log(`Getting all email accounts, pagination: ${pagination}`);
+    return EmailAccount.getAll(this.datastoreService, pagination);
+  }
+
+  public async delete(id: string): Promise<void> {
+    this.logger.log(`Deleting email account by id=${id}`);
+    return EmailAccount.delete(this.datastoreService, id);
+  }
+
+  async associateEmailAccountsWithCampaign(
+    emailAccountIds: string[],
+    campaignId: string,
+  ) {
+    const emailAccounts = await EmailAccount.getManyByIds(
+      this.datastoreService,
+      emailAccountIds,
+    );
+
+    if (emailAccountIds.length !== emailAccounts.length) {
+      const missingIds = R.difference(
+        emailAccountIds,
+        emailAccounts.map((emailAccount) => emailAccount.id),
+      );
+      this.logger.error(
+        `The following email accounts are missing: ${missingIds}`,
+      );
+      throw new NotFoundException(
+        'Could not found all required email accounts',
+      );
+    }
+
+    await Promise.all(
+      emailAccounts.map(async (emailAccount: EmailAccount) => {
+        // We don't need to modify the emailAccount if it already associated with the campaign
+        if (emailAccount.campaignIds.includes(campaignId)) {
+          return;
+        }
+        emailAccount.associateWithCampaign(campaignId);
+        await emailAccount.save(this.datastoreService);
+      }),
+    );
+  }
+
+  async getBestEmailAccounts(
+    smartleadClientId: string,
+    numberOfEmailAccount: number,
+  ): Promise<EmailAccount[]> {
+    return EmailAccount.getBestXEmailAccounts(
+      this.datastoreService,
+      smartleadClientId,
+      numberOfEmailAccount,
+    );
+  }
+}
