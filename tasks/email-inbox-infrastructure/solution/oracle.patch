+import {
+  backoffRetryOption,
+  initMongoDb,
+  logger,
+  retrieveAllSmartLeadInboxes,
+  retrieveSmartLeadInboxDetail,
+} from './common';
+import { EmailAccount } from '../entities/emailAccount.entity';
+import { DatastoreService } from '../../datastore/datastore.service';
+import process from 'node:process';
+import { documentType } from '../../datastore/entites/documentType';
+import { backOff } from 'exponential-backoff';
+
+const saveSingleInbox = async (data: any) => {
+  const datastoreService = new DatastoreService();
+
+  const inboxAlreadyImported =
+    await DatastoreService.mongoDataStoreEntity.getManyAndAggregate(
+      {
+        $or: [{ id: `${data.id}` }, { email: data.from_email }],
+      },
+      {
+        documentType: documentType.EMAIL_ACCOUNT,
+      },
+      [],
+    );
+
+  if (inboxAlreadyImported.length > 0) {
+    logger.info(
+      `The inbox id=${data.id} email=${data.from_email}  has already been imported.`,
+    );
+    return;
+  }
+
+  const smartleadEmailAccount = await backOff(
+    () => retrieveSmartLeadInboxDetail(data.id),
+    backoffRetryOption,
+  );
+  const emailAccount = new EmailAccount({
+    id: `${smartleadEmailAccount.id}`,
+    smartleadInboxId: `${smartleadEmailAccount.id}`,
+    smartleadClientId:
+      smartleadEmailAccount.client_id && `${smartleadEmailAccount.client_id}`,
+    email: smartleadEmailAccount.from_email,
+    deliverabilityScore: smartleadEmailAccount.warmup_details.warmup_reputation,
+    createdAt: smartleadEmailAccount.created_at,
+    tags: data.email_account_tag_mappings.map((item) => ({
+      id: `${item.tag.id}`,
+      name: item.tag.name,
+    })),
+  });
+
+  await emailAccount.save(datastoreService);
+};
+
+const importSmartleadInboxes = async (): Promise<void> => {
+  const smartLeadEmailAccounts = await backOff(
+    () => retrieveAllSmartLeadInboxes(),
+    backoffRetryOption,
+  );
+
+  await initMongoDb();
+
+  for (const emailAccount of smartLeadEmailAccounts) {
+    await saveSingleInbox(emailAccount);
+  }
+};
+
+logger.setContext('import-smartlead-inboxes');
+
+importSmartleadInboxes()
+  .then(() => {
+    logger.info('Successfully imported Smartlead inboxes');
+    process.exit(0);
+  })
+  .catch((error) => {
+    logger.error('Failed to import smartlead inboxes: ', error);
+    process.exit(1);
+  });
