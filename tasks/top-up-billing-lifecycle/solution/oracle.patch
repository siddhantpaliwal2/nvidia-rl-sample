+                    if (invoices && invoices.length > 0) {
+                        await Promise.all(
+                            invoices.map(async ({ invoice, contract, customer }) => {
+                                const total = invoice.totalAmountWithoutTax;
+                                if (total !== 0) {
+                                    const credits = customer?.creditBalance ? parseFloat(customer.creditBalance) : 0;
+                                    await this.creditService.create({
