+import { Module } from '@nestjs/common';
+import { OfferingTopUpChecker } from './offeringTopUp.service.js';
+import { BullModule } from '@nestjs/bull';
+import { PrivateAPICustomerModule } from '../../customer/customer.module.js';
+import { PrivateAPISettingsModule } from '../../setting/settings.module.js';
+import { PaymentModule } from '../../payment/payment.module.js';
+import { PrivateAPIOfferingModule } from '../../offering/offering.module.js';
+import { PrivateAPIInvoicesModule } from '../../invoice/invoices.module.js';
+import { ContractModule } from '../../contract/contract.module.js';
+import { CreditModule } from '../../credit/credit.module.js';
+
+@Module({
+    controllers: [],
+    providers: [OfferingTopUpChecker],
+    imports: [
+        PrivateAPISettingsModule,
+        PrivateAPIOfferingModule,
+        PaymentModule,
+        PrivateAPICustomerModule,
+        PrivateAPIInvoicesModule,
+        ContractModule,
+        CreditModule,
+        BullModule.registerQueue({
+            name: 'scheduler_billing_queue',
+        }),
+    ],
+})
+export class OfferingTopUpModule {}
diff --git a/src/microservices/offeringTopUpHandler/offeringTopUp.service.ts b/src/microservices/offeringTopUpHandler/offeringTopUp.service.ts
