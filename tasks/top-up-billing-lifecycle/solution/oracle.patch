index 0000000000000000000000000000000000000000..e7563a15f8c523a3868bff4857eca548f8188cb8
--- /dev/null
+++ b/src/microservices/offeringTopUpHandler/offeringTopUp.service.ts
@@ -0,0 +1,149 @@
+import { Job } from 'bull';
+import { SchedulerEntity } from '../../scheduler/entities/scheduler.entity.js';
+import { OnQueueFailed, Process, Processor } from '@nestjs/bull';
+import { Inject, Logger, forwardRef } from '@nestjs/common';
+import { CustomerService, ReadAllCustomerResponse } from '../../customer/customer.service.js';
+import { AuditService } from '../../audit/audit.service.js';
+import { AuditScope } from '../../audit/entities/audit.interface.js';
+import { PaymentService } from '../../payment/payment.service.js';
+import { SettingsService } from '../../setting/settings.service.js';
+import { ContractService } from '../../contract/contract.service.js';
+import { DatetimeUtils } from '../../utils/datetime.js';
+import { CreditService } from '../../credit/credit.service.js';
+import { OfferingTopUpDto } from './dto/offeringTopUp.dto.js';
+import { Invoice, InvoiceLineItems } from '../../invoice/entities/invoice.entity.js';
+import { InvoicesService } from '../../invoice/invoices.service.js';
+import { ReadContractResponseDto } from '../../contract/dto/readContract.dto.js';
+import { ReadAllCustomersResponseData } from '../../customer/entities/customer.entity.js';
+
+@Processor('scheduler_billing_queue')
+export class OfferingTopUpChecker {
+    private static readonly logger = new Logger(OfferingTopUpChecker.name);
+    constructor(
+        @Inject(forwardRef(() => CustomerService)) readonly customerService: CustomerService,
+        @Inject(forwardRef(() => PaymentService)) readonly paymentService: PaymentService,
+        @Inject(forwardRef(() => SettingsService)) readonly settingsService: SettingsService,
+        @Inject(forwardRef(() => ContractService)) readonly contractService: ContractService,
+        @Inject(forwardRef(() => CreditService)) readonly creditService: CreditService,
+        @Inject(forwardRef(() => InvoicesService)) readonly invoiceService: InvoicesService,
+    ) {}
+
+    @Process('offeringTopUpChecker')
+    async offeringTopUpChecker({ data: { scheduleParameters, subject } }: Job<SchedulerEntity>) {
+        try {
+            OfferingTopUpChecker.logger.log(
+                //eslint-disable-next-line
+                //@ts-ignore
+                `Processing offering top up. subject: ${subject}, scheduleParameters: ${scheduleParameters?.businessID} ${scheduleParameters?.offeringId}`,
+            );
+            const now = new Date();
+            const { offeringId, businessID } = scheduleParameters as OfferingTopUpDto;
+            const start = DatetimeUtils.startOfLastHour(now);
+            const end = DatetimeUtils.endOfLastHour(now);
+
+            const [res, readSettingsRes] = await Promise.all([
+                this.customerService.findAll({ businessID }),
+                this.settingsService.findAll({ businessID }),
+            ]);
+            const readSettingsResponseData = readSettingsRes[0];
+            const customers = res.data;
+            OfferingTopUpChecker.logger.log(`Found ${customers.length} customers`);
+            if (customers && customers.length > 0) {
+                const customersWithContract = customers.filter((customer) =>
+                    customer.enrollments.find((contract) => contract?.offering?.offeringId === offeringId),
+                );
+                OfferingTopUpChecker.logger.log(
+                    `Found ${customersWithContract.length} customers with contract: ${offeringId}`,
+                );
+                if (customersWithContract && customersWithContract?.length > 0) {
+                    const invoices = await Promise.all(
+                        customersWithContract.map(
+                            async (
+                                customer,
+                            ): Promise<{
+                                invoice: Invoice;
+                                contract: ReadContractResponseDto;
+                                customer: ReadAllCustomersResponseData;
+                            }> => {
+                                const contract = customer.enrollments.find(
+                                    (contract) => contract?.offering?.offeringId === offeringId,
+                                );
+                                const lineItems = new InvoiceLineItems();
+                                const invoiceLineItems = await this.contractService.generateLineItemsForEnrollment({
+                                    startDate: start,
+                                    endDate: end,
+                                    enrollmentRes: contract,
+                                    customer,
+                                    readSettingsResponseData,
+                                    businessID,
+                                    lineItems,
+                                });
+                                const invoice = await this.invoiceService.buildInvoice({
