new file mode 100644
index 0000000000000000000000000000000000000000..0b70d57c2ddb8ea4a13cc5b4f20b5526bf607d40
--- /dev/null
+++ b/src/offering/dto/TopUpValidator.ts
@@ -0,0 +1,77 @@
+import { Injectable } from '@nestjs/common';
+import {
+    registerDecorator,
+    ValidationArguments,
+    ValidationOptions,
+    ValidatorConstraint,
+    ValidatorConstraintInterface,
+} from 'class-validator';
+import { OfferingType } from '../entities/OfferingType.js';
+import { CreateOfferingDTO, ValidBillingCycles } from './createOffering.dto.js';
+
+@ValidatorConstraint({ name: 'TopUpBillingCycleRule', async: false })
+@Injectable()
+export class TopUpBillingCycleRule implements ValidatorConstraintInterface {
+    validate(billingCycle: string, args: ValidationArguments) {
+        const offeringType = (args.object as CreateOfferingDTO).offeringType;
+        if (billingCycle === undefined) {
+            return true;
+        }
+        if (offeringType && offeringType === OfferingType.subscription) {
+            return billingCycle !== ValidBillingCycles.topUp;
+        }
+        if (offeringType && offeringType === OfferingType.usageBased) {
+            return true;
+        }
+    }
+
+    defaultMessage() {
+        return 'Billing Cycle topUp only works with usage-based offerings';
+    }
+}
+
+export function TopUpBillingCycleValidator(property: string, validationOptions?: ValidationOptions) {
+    return function (object: unknown, propertyName: string) {
+        registerDecorator({
+            name: 'BillingCycleValidator',
+            target: object.constructor,
+            propertyName: propertyName,
+            constraints: [property],
+            options: validationOptions,
+            validator: TopUpBillingCycleRule,
+        });
+    };
+}
+
+@ValidatorConstraint({ name: 'TopUpAmountRule', async: false })
+@Injectable()
+export class TopUpRule implements ValidatorConstraintInterface {
+    validate(topUpAmount: string, args: ValidationArguments) {
+        const billingCycle = (args.object as CreateOfferingDTO).billingCycle;
+        if (billingCycle === undefined) {
+            return false;
+        }
+        if (billingCycle !== ValidBillingCycles.topUp && topUpAmount) {
+            return false;
+        } else {
+            return true;
+        }
+    }
+
+    defaultMessage() {
+        return 'If billingCycle is not topUp, topUpAmount and topUpThreshold should not be present';
+    }
+}
+
+export function TopUpValidator(property: string, validationOptions?: ValidationOptions) {
+    return function (object: unknown, propertyName: string) {
+        registerDecorator({
+            name: 'TopUpAmountValidator',
+            target: object.constructor,
+            propertyName: propertyName,
+            constraints: [property],
+            options: validationOptions,
+            validator: TopUpRule,
+        });
+    };
+}
